<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sapo.printer.agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/Sapo Printer.app/Contents/MacOS/sapo-printer-agent</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>UserName</key>
    <string>root</string>
    <key>StandardOutPath</key>
    <string>/var/log/sapo-printer-agent.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/sapo-printer-agent.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>SAPO_AGENT_DATA_DIR</key>
        <string>/Library/Application Support/SapoPrinter</string>
    </dict>
</dict>
</plist>
