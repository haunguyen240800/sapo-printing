<?xml version="1.0" encoding="UTF-8"?>
<!--
  Wix fragment — include vào Tauri MSI builder via tauri.conf.json:
    "bundle": { "windows": { "wix": { "fragmentPaths": ["installers/windows/wix-fragment.wxs"] } } }

  Chạy install-ca-cert.ps1 sau khi files được install, uninstall-ca-cert.ps1 trước khi remove.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <CustomAction Id="InstallCaCert"
                  ExeCommand='powershell.exe -ExecutionPolicy Bypass -File "[INSTALLDIR]install-ca-cert.ps1"'
                  Directory="INSTALLDIR"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <CustomAction Id="UninstallCaCert"
                  ExeCommand='powershell.exe -ExecutionPolicy Bypass -File "[INSTALLDIR]uninstall-ca-cert.ps1"'
                  Directory="INSTALLDIR"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Đăng ký + start Windows Service (SYSTEM) cho silent auto-update. -->
    <CustomAction Id="RegisterAgentService"
                  ExeCommand='powershell.exe -NoProfile -ExecutionPolicy Bypass -File "[INSTALLDIR]register-agent-service.ps1"'
                  Directory="INSTALLDIR"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Stop service trước khi ghi đè file (update) hoặc trước khi gỡ (uninstall). -->
    <CustomAction Id="UnregisterAgentService"
                  ExeCommand='powershell.exe -NoProfile -ExecutionPolicy Bypass -File "[INSTALLDIR]unregister-agent-service.ps1"'
                  Directory="INSTALLDIR"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <!-- Dừng service cũ trước khi copy đè files (release lock trên agent exe). -->
      <Custom Action="UnregisterAgentService" Before="InstallFiles">Installed</Custom>
      <Custom Action="InstallCaCert" After="InstallFiles">NOT Installed</Custom>
      <Custom Action="RegisterAgentService" After="InstallCaCert">NOT (REMOVE="ALL")</Custom>
      <Custom Action="UninstallCaCert" Before="RemoveFiles">Installed AND (REMOVE="ALL")</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
