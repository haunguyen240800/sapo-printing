{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sapo-printer",
  "version": "0.1.0",
  "identifier": "com.sapo.printer",
  "build": {
    "beforeDevCommand": "pnpm run dev:web",
    "beforeBuildCommand": "pnpm run build:web",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sapo Printer",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {}
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "bin/pdfium.dll": "./",
      "../installers/windows/install-ca-cert.ps1": "./",
      "../installers/windows/uninstall-ca-cert.ps1": "./"
    },
    "windows": {
      "wix": {
        "fragmentPaths": [
          "../installers/windows/wix-fragment.wxs"
        ]
      },
      "nsis": {
        "installerHooks": "../installers/windows/nsis-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxMkIxRTg0QzJCQ0NENjAKUldSZ3piekNoQjRya1pLalBEb0NQMUhnK1pYSnFYQWNvMEhWWnJzdWx5T3F6YlZZODRvN0hWc08K",
      "endpoints": [
        "https://github.com/haunguyen240800/sapo-printing/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}