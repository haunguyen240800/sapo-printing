{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sapo-printer",
  "version": "0.1.0",
  "identifier": "com.sapo.printer",
  "build": {
    "beforeDevCommand": "pnpm run dev:web",
    "beforeBuildCommand": "pnpm run build:web",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sapo Printer",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
