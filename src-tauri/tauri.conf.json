{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sapo Printer Pro Max",
  "version": "1.0.0",
  "identifier": "com.sapo.printer",
  "build": {
    "beforeDevCommand": "pnpm run dev:web",
    "beforeBuildCommand": "pnpm run build:web",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sapo Printer Pro Max",
        "width": 900,
        "height": 600,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {}
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "bin/pdfium.dll": "./",
      "../installers/windows/install-ca-cert.ps1": "./",
      "../installers/windows/uninstall-ca-cert.ps1": "./",
      "../installers/windows/register-agent-service.ps1": "./",
      "../installers/windows/unregister-agent-service.ps1": "./"
    },
    "windows": {
      "wix": {
        "fragmentPaths": ["../installers/windows/wix-fragment.wxs"]
      },
      "nsis": {
        "installerHooks": "../installers/windows/nsis-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxMkIxRTg0QzJCQ0NENjAKUldSZ3piekNoQjRya1pLalBEb0NQMUhnK1pYSnFYQWNvMEhWWnJzdWx5T3F6YlZZODRvN0hWc08K",
      "endpoints": ["https://github.com/haunguyen240800/sapo-printing/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
